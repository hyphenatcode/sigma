# Frontend environment (Next.js). Copy to .env.local for local development,
# or set these in Vercel's project settings.
#
# Both are public by design — NEXT_PUBLIC_* values are inlined into the browser
# bundle. The anon key identifies the project; it is not a secret, and it is
# not what protects your data. Sigma's API independently verifies the session
# JWT on every request.
#
# Leave these unset to run against a backend with ALLOW_INSECURE_HEADER_AUTH=true:
# the UI then falls back to an unverified email box and says so on screen.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the API lives. Used by next.config.mjs to proxy /api/* in development.
SIGMA_API_URL=http://localhost:8000
