# --- Database (§7) ---
DATABASE_URL=postgresql+psycopg2://sigma:sigma@localhost:5432/sigma

# --- Turkish interpretation layer (§3.6) ---
# Optional. Without it Sigma renders interpretations from the deterministic
# Turkish templates; the statistics are identical either way.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Storage (§5 KVKK: datasets are encrypted at rest) ---
# REQUIRED in any deployment. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it a per-process ephemeral key is used and stored datasets become
# unreadable after a restart.
STORAGE_ENCRYPTION_KEY=

# --- App ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
