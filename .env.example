# Keep this file as .env in the REPOSITORY ROOT. It is read from there
# regardless of which directory you start the app from.
#
# In a deployment, set these as real environment variables instead — the
# container image deliberately does not include a .env file.

# --- Database (§7) ---
DATABASE_URL=postgresql+psycopg2://sigma:sigma@localhost:5432/sigma

# --- Turkish interpretation layer (§3.6) ---
# Optional. Without it Sigma renders interpretations from the deterministic
# Turkish templates; the statistics are identical either way.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Storage (§5 KVKK: datasets are encrypted at rest) ---
# REQUIRED in any deployment. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it a per-process ephemeral key is used and stored datasets become
# unreadable after a restart. ENVIRONMENT=production refuses to start without it.
#
# Treat this like a database password: store it in your platform's secret
# manager, never in the image, and keep a copy somewhere you can recover from.
# Losing it means losing every uploaded dataset, irreversibly.
STORAGE_ENCRYPTION_KEY=

# --- Auth (§7: Supabase) ---
# The project URL is all most deployments need: the JWKS endpoint and the
# expected token issuer are both derived from it.
SUPABASE_URL=https://your-project-ref.supabase.co
# Only needed if your project still signs tokens with the legacy symmetric
# secret. Projects using asymmetric signing keys verify via JWKS instead.
SUPABASE_JWT_SECRET=

# Development escape hatch: identify the caller by an X-User-Email header.
# This is NOT authentication — any caller can claim any identity, and read that
# user's uploaded data. It exists so local development and the test suite do
# not need a live Supabase project. ENVIRONMENT=production refuses to start
# with it enabled.
ALLOW_INSECURE_HEADER_AUTH=true

# --- App ---
# Setting ENVIRONMENT=production turns on the startup guardrails in
# app/config.py: the deployment then refuses to start if the storage key is
# missing, DATABASE_URL is still this example value, DEBUG is on, or
# CORS_ORIGINS still points at localhost.
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# --- Deployment only ---
# Number of uvicorn workers (the container defaults to 2).
# WEB_CONCURRENCY=2
# Set to 1 to run `alembic upgrade head` on container start. Leave unset and
# use an explicit release step when running more than one replica.
# RUN_MIGRATIONS=0
